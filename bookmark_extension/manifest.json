{
  "manifest_version": 3,
  "name": "CoinGecko Archive Bookmark Bridge",
  "version": "1.0.0",
  "description": "Connects the local CoinGecko Archive page to selected Chrome bookmarks.",
  "permissions": ["bookmarks"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
